# ==============================================================================
# Rectilinear Redundancies - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Network Configuration
PORT=8787
HOST=0.0.0.0

# Security Credentials (REQUIRED)
# Secret bearer token used to authenticate administrative operations (GET/DELETE /api/users)
ADMIN_TOKEN=change_this_to_a_secure_random_token

# Optional Site Authorization Key
# If set, clients must send this key in the 'X-Site-Key' header when posting data to /api/sync
SITE_KEY=

# CORS Origin Allowed (default: * for all domains)
ALLOW_ORIGIN=*

# Path to persistent JSON database file (default: data.json in current directory)
DATA_FILE=data.json
